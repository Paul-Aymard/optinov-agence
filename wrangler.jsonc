{
  // Déploiement Cloudflare Workers : le site est 100 % statique (dossier out/,
  // produit par `npm run build`), servi par le système de fichiers statiques.
  // Aucun code ne tourne côté serveur : le tableau de bord vit sur Render
  // (voir README, « Tableau de bord »).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optinov-agence",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
